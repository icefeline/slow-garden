# slow garden — environment variables
#
# copy to .env.local for local development. never commit .env.local.
# in production these are set in Vercel → Settings → Environment Variables,
# per-environment (Production / Preview / Development), marked Sensitive.

# required — Claude insight generation (/api/calculate-transit, /api/welcome-insight).
# note the SLOW_GARDEN_ prefix: the code reads this name, not ANTHROPIC_API_KEY.
# the prefix is deliberate — it keeps the key from colliding with the Anthropic
# SDK's default ANTHROPIC_API_KEY pickup.
# set a spend limit on this key in the Anthropic console — it is the real
# backstop against a runaway bill, more reliable than the per-IP abuse guards.
SLOW_GARDEN_ANTHROPIC_KEY=

# required — per-IP abuse guards in middleware.ts.
# if either is absent the limiters are silently disabled and every API route
# runs unguarded, so treat these as required in production, not optional.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# planned — voice feature (ElevenLabs TTS). not yet read by any code.
ELEVENLABS_API_KEY=

# error tracking (Sentry, EU region). Publishable by design — it only permits
# sending events, not reading them — but kept in env so it can differ per
# environment. Absent means Sentry stays inert rather than erroring, so local
# dev works without it.
NEXT_PUBLIC_SENTRY_DSN=

# build-time only, for uploading source maps. Generate at
# Sentry → Settings → Auth Tokens. Never commit this one.
SENTRY_AUTH_TOKEN=


